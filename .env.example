# Copy this file to .env and fill it in.

# --- Gmail / Google Workspace (default) ---
# Use an App Password, NOT your normal password:
#   Google Account -> Security -> 2-Step Verification (turn on) -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Name shown in the From field (optional)
FROM_NAME=

# --- Other providers ---
# Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Zoho:                    SMTP_HOST=smtp.zoho.in        SMTP_PORT=465

# Seconds to wait between emails (keeps your account from being flagged)
SEND_DELAY_SECONDS=2
# Total attachment size limit per email, in MB (Gmail allows 25)
MAX_ATTACHMENT_MB=20

# --- WhatsApp (uses WhatsApp Web with your own number) ---
# Country code added to 10-digit numbers
WA_DEFAULT_COUNTRY_CODE=91
# Browser to use: chrome or msedge (must be installed)
WA_BROWSER=chrome
# Random pause between messages, in seconds. Do not go much lower - fast sending gets numbers banned.
WA_MIN_DELAY_SECONDS=15
WA_MAX_DELAY_SECONDS=40
# Stop after this many WhatsApp messages per day (resume the next day)
WA_DAILY_LIMIT=150
